# 複製這個檔案為 .env 並填入實際值，切勿將 .env 提交到版本控制

# 伺服器
PORT=3001
# 允許呼叫 API 的前端網域
CORS_ORIGIN=http://localhost:8080

# 資料庫連線（使用 docker-compose 時 DB_HOST 會自動改為 db，此處設定僅供本機直接執行 node server/index.js 使用）
DB_HOST=localhost
DB_USER=hrms_user
DB_PASSWORD=change_me
DB_NAME=hrms_database
DB_PORT=3306
# 僅 docker-compose 建立資料庫容器時需要，用來設定 MariaDB 的 root 密碼
DB_ROOT_PASSWORD=change_me_too

# JWT（請改成一組長度足夠、隨機產生的字串）
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# 系統通知（新的請假/加班申請送出時通知 HR/主管）：none / smtp / teams，預設 none 不發送
NOTIFICATION_CHANNEL=none

# NOTIFICATION_CHANNEL=smtp 時使用
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=hrms@example.com
# 收通知的信箱，多個以逗號分隔
NOTIFICATION_TO_EMAILS=hr@example.com,manager@example.com
# 驗證方式：basic（帳密）或 oauth2（Microsoft 365 / Google Workspace 等已停用密碼登入的信箱需要）
SMTP_AUTH_METHOD=basic
# SMTP_AUTH_METHOD=basic 時使用
SMTP_USER=
SMTP_PASSWORD=
# SMTP_AUTH_METHOD=oauth2 時使用（需自行到信箱服務商的後台申請應用程式並取得 refresh token）
SMTP_OAUTH_USER=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=

# NOTIFICATION_CHANNEL=teams 時使用：Teams 頻道的「傳入 Webhook」連接器網址
TEAMS_WEBHOOK_URL=
