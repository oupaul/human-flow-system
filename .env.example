# 複製這個檔案為 .env 並填入實際值，切勿將 .env 提交到版本控制

# 伺服器
PORT=3001
# CORS_ORIGIN：使用者在瀏覽器網址列實際輸入的網址（協定＋主機＋連接埠，結尾不加 /），
# 不是後端的 3001（3001 沒有對外開放）。
#   • 內網直接用 IP／主機名稱連：http://192.168.1.50:8080 或 http://games01:8080
#   • 有網域與 HTTPS：https://hr.example.com
#   • 連接埠要跟 FRONTEND_PORT 一致（deploy.sh 若自動換埠，這裡也要跟著改）
# 目前前端與 API 走同一個網址，所以填錯通常不會立刻出問題；
# 但之後改用網域或 HTTPS、或從別的網址呼叫 API 時，沒對應修改會被瀏覽器擋下（CORS 錯誤）。
# 改完後執行 ./deploy.sh 重新套用。
CORS_ORIGIN=http://localhost:8080

# Docker 部署的對外埠（deploy.sh 會自動檢查，被佔用時自動換一個並寫在這裡）
# FRONTEND_PORT=8080
# 資料庫只綁定在主機的 127.0.0.1（不對外），要用 DB 工具連線請從本機或用 SSH 通道
# DB_HOST_PORT=3306

# 每日自動備份（backup 服務）：時間、保留天數、存放目錄。目錄建議指到另一顆磁碟或掛載的網路磁碟
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAYS=30
# BACKUP_DIR=./backups

# 資料庫連線（使用 docker-compose 時 DB_HOST 會自動改為 db，此處設定僅供本機直接執行 node server/index.js 使用）
DB_HOST=localhost
DB_USER=hrms_user
DB_PASSWORD=change_me
DB_NAME=hrms_database
DB_PORT=3306
# 僅 docker-compose 建立資料庫容器時需要，用來設定 MariaDB 的 root 密碼
DB_ROOT_PASSWORD=change_me_too

# JWT（請改成一組長度足夠、隨機產生的字串）
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Microsoft 365（Entra ID）單一登入（選用）：不需要 client secret，只要填下面兩個「公開識別碼」，
# 兩個都填了才會啟用，登入頁才會出現「使用 Microsoft 帳號登入」按鈕。
# 只限貴公司自己的 M365 租戶內帳號登入，且帳號的電子郵件必須已經對應到系統裡的員工帳號（username），
# 否則登入會被拒絕並提示聯絡管理員。Entra ID 要把應用程式註冊成「單頁應用程式（SPA）」，
# 重新導向 URI 是 https://你的網域/sso-callback（本機測試可用 http://localhost:8080/sso-callback）。
# 注意：瀏覽器的 PKCE 登入需要 HTTPS（或 localhost），純 HTTP 的網址無法使用。
# 設定步驟請見 API_SETUP_README.md「Microsoft 365 單一登入」章節
MS_TENANT_ID=
MS_CLIENT_ID=

# 系統通知（新的請假/加班申請送出時通知 HR/主管）：none / smtp / teams，預設 none 不發送
# 注意：這些設定現在改為存在資料庫（notification_settings 表），可由 admin 在「系統設定」頁面直接管理。
# 這裡的環境變數只在該表第一次建立、內容為空時，拿來當作初始值使用，之後修改請直接到系統設定頁面操作，不會再讀這裡。
NOTIFICATION_CHANNEL=none

# NOTIFICATION_CHANNEL=smtp 時使用
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=hrms@example.com
# 收通知的信箱，多個以逗號分隔
NOTIFICATION_TO_EMAILS=hr@example.com,manager@example.com
# 驗證方式：basic（帳密）或 oauth2（Microsoft 365 / Google Workspace 等已停用密碼登入的信箱需要）
SMTP_AUTH_METHOD=basic
# SMTP_AUTH_METHOD=basic 時使用
SMTP_USER=
SMTP_PASSWORD=
# SMTP_AUTH_METHOD=oauth2 時使用（需自行到信箱服務商的後台申請應用程式並取得 refresh token）
SMTP_OAUTH_USER=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=

# NOTIFICATION_CHANNEL=teams 時使用：Teams 頻道的「傳入 Webhook」連接器網址
TEAMS_WEBHOOK_URL=
